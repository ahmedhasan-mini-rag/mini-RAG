FILE_ALLOWED_TYPES=['text/plain', 'application/pdf']
FILE_MAX_SIZE=10
FILE_CHUNK_SIZE=512000 # 512 KB

MONGODB_URL= # e.g., "mongodb://<user_name>:<password>@localhost:8090"
MONGODB_DATABASE= # e.g., "mini-rag"

# llms settings

GENERATION_MODEL_PROVIDER="cohere"
EMBEDDING_MODEL_PROVIDER="cohere"

OPENAI_API_KEY=
OPENAI_BASE_URL=
COHERE_API_KEY=
GOOGLE_API_KEY=

GENERATION_MODEL_ID=
EMBEDDING_MODEL_ID=

# note that some embedding model don't support specifying the embedding size
# in this case, comment out the 'EMBEDDING_SIZE' field below to avoid errors
# EMBEDDING_SIZE=

DEFAULT_MAX_OUTPUT_TOKENS=1200
DEFAULT_MAX_INPUT_CHARS=2200
DEFAULT_TEMPERATURE=0.5

# vector dbs settings

VECTORDB_PROVIDER=
VECTORDB_SIMILARITY_METRIC="cosine"