          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "title": "Total Points",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Sum of all vectors across selected collections",
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#00d4ff", "mode": "fixed" },
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "#00d4ff" }]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(collection_vectors{collection=~\"$collection\"})",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "title": "Total Vectors",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Current REST request throughput (all methods)",
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#00d4ff", "mode": "fixed" },
          "decimals": 2,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "#00d4ff" }]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "clamp_min(sum(rate(rest_responses_total{job=\"qdrant\"}[2m])), 0)",
          "instant": false,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "title": "REST Req / s",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "REST request throughput vs gRPC request throughput over time",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 18,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "REST / s" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "#00d4ff", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "gRPC / s" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "#b877d9", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Failures / s" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "#f2495c", "mode": "fixed" } },
              { "id": "custom.fillOpacity", "value": 10 }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 10,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max", "mean"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "clamp_min(sum(rate(rest_responses_total{job=\"qdrant\"}[2m])), 0)",
          "legendFormat": "REST / s",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "clamp_min(sum(rate(grpc_responses_total{job=\"qdrant\"}[2m])), 0)",
          "legendFormat": "gRPC / s",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "clamp_min(sum(rate(rest_responses_fail_total{job=\"qdrant\"}[2m])), 0)",
          "legendFormat": "Failures / s",
          "refId": "C"
        }
      ],
      "title": "Request Rate \u2014 Live",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Total active memory of the Qdrant process",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#73bf69" },
              { "color": "#ff780a", "value": 1073741824 },
              { "color": "#f2495c", "value": 4294967296 }
            ]
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 5 },
      "id": 6,
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(memory_active_bytes{job=\"qdrant\"})",
