        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "clamp_min(sum(rate(rest_responses_fail_total{job=\"qdrant\"}[5m])), 0) / (clamp_min(sum(rate(rest_responses_total{job=\"qdrant\"}[5m])), 0) + 0.0001)",
